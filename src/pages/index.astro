---
import ProjectArt from '../components/ProjectArt.astro';
import ProjectTile from '../components/ProjectTile.astro';
import Base from '../layouts/Base.astro';
import { getAvatar, getShowcase } from '../lib/data';
import { initials } from '../lib/gravatar';
import { CONTRIBUTIONS, FLAGSHIP, GROUPS, UPSTREAM_PRS_MERGED } from '../lib/projects';
import {
  ECOSYSTEM_URL,
  ecosystemPackageUrl,
  formatCount,
  formatHeadline,
  githubUrl,
  installCommand,
  pluralize,
} from '../lib/showcase';

const NAME = 'Arkadiusz Biel';
const [showcase, avatar] = await Promise.all([getShowcase(), getAvatar()]);
const { flagship, top, packageCount, totalDownloads, flagshipPackageCount, flagshipDownloads } = showcase;
const core = flagship[0]!;
const install = core.packages.find((p) => p.id.toLowerCase() === FLAGSHIP.install.toLowerCase()) ?? core.lead;
const groups = (['infrastructure', 'libraries'] as const).map((key) => ({ key, ...GROUPS[key], projects: showcase[key] }));
---

<Base
  title="Arkadiusz Biel — .NET open-source infrastructure"
  description="Arkadiusz Biel — .NET developer building open-source infrastructure libraries: AsyncAPI & Arazzo tooling, persistent queues, and .NET Aspire extensions."
>
  <header class="hero">
    <span class="eyebrow">.NET · Open Source</span>
    <div class="hero-top">
      <div class="intro">
        <h1>{NAME}</h1>
        <p class="lede">
          I build open-source .NET infrastructure: the parts of a system that live <em>between</em> services.
          Currently <strong>AsyncAPI &amp; Arazzo tooling</strong>, <strong>persistent queues</strong> and <strong>.NET Aspire</strong> extensions.
        </p>
      </div>
      {
        avatar ? (
          <img class="avatar" src={avatar} alt={NAME} width="192" height="192" />
        ) : (
          <span class="avatar initials" aria-hidden="true">{initials(NAME)}</span>
        )
      }
    </div>

    <ul class="stats">
      <li><b>{packageCount}</b><span>NuGet packages</span></li>
      <li><b>{formatHeadline(totalDownloads)}</b><span>downloads</span></li>
      <li><b>{UPSTREAM_PRS_MERGED}</b><span>upstream PRs merged</span></li>
    </ul>

    <div class="links cta">
      <a class="primary" href={`${ECOSYSTEM_URL}/`}>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 1.5h6v6H1zM9 1.5h6v6H9zM1 9.5h6v6H1zM9 9.5h6v6H9z" fill-opacity=".9" /></svg>
        Explore the ecosystem
      </a>
      <a href="https://github.com/bielu">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
        GitHub
      </a>
      <a href="https://www.nuget.org/profiles/bielu">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0 1 4v8l7 4 7-4V4L8 0Zm0 2.3 5 2.86v5.68L8 13.7 3 10.84V5.16L8 2.3Z" /><circle cx="8" cy="8" r="2.4" /></svg>
        NuGet
      </a>
      <a href="https://www.linkedin.com/in/bielu">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.6 4.5a1.9 1.9 0 1 1 0-3.8 1.9 1.9 0 0 1 0 3.8ZM.9 15.3h5.4V5.9H.9v9.4Zm8-9.4H8.1v9.4h5.4v-5.2c0-2.9-3.6-2.7-4.6-1.3V5.9Z" /></svg>
        LinkedIn
      </a>
      <a href="https://github.com/sponsors/bielu">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14.25 2.4 8.9a3.55 3.55 0 0 1 5-5.03l.6.58.6-.58a3.55 3.55 0 0 1 5 5.03L8 14.25Z" /></svg>
        Sponsor
      </a>
    </div>
  </header>

  <section>
    <h2>Flagship</h2>
    <p class="sub">The bulk of my current work: bringing the OpenAPI developer experience to the specs that describe everything else.</p>

    <article class="flagship">
      <div class="flag-head">
        <ProjectArt art={core.art} hue={core.project.hue} size={72} />
        <div>
          <h3><a href={FLAGSHIP.docs}>{FLAGSHIP.name}</a></h3>
          <p class="meta mono">
            {pluralize(flagshipPackageCount, 'package')} · {formatCount(flagshipDownloads)} downloads
            {install?.stableVersion && <> · v{install.stableVersion}</>}
          </p>
        </div>
      </div>
      <p class="flag-summary">{FLAGSHIP.summary}</p>

      {
        install && (
          <div class="install">
            <pre class="mono"><code>{installCommand(install)}</code></pre>
            <button type="button" class="copy" data-copy={installCommand(install)}>Copy</button>
          </div>
        )
      }

      <div class="parts">
        {flagship.map((stats) => <ProjectTile stats={stats} compact />)}
      </div>

      <div class="links">
        <a href={FLAGSHIP.docs}>Documentation →</a>
        <a href={FLAGSHIP.repo}>Source →</a>
        <a href={`${ECOSYSTEM_URL}/#asyncapi`}>All {flagshipPackageCount} packages →</a>
      </div>
    </article>
  </section>

  {
    groups.map((g) => (
      <section>
        <h2>{g.title}</h2>
        <p class="sub">{g.sub}</p>
        <div class="grid">
          {g.projects.map((stats) => (
            <ProjectTile stats={stats} />
          ))}
        </div>
      </section>
    ))
  }

  <section>
    <h2>Most downloaded</h2>
    <p class="sub">The packages people install most, straight from NuGet.</p>
    <ol class="top">
      {
        top.map((pkg, i) => (
          <li>
            <span class="rank mono">{i + 1}</span>
            <a class="id mono" href={ecosystemPackageUrl(pkg.id)}>{pkg.id}</a>
            <span class="downloads mono">{formatCount(pkg.totalDownloads)}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section>
    <a class="ecosystem" href={`${ECOSYSTEM_URL}/`}>
      <span class="eco-text">
        <span class="eco-eyebrow">packages.bielu.pl</span>
        <strong>Browse the whole ecosystem</strong>
        <span>
          All {packageCount} NuGet packages grouped by category, with install commands, versions and deprecation notes.
        </span>
      </span>
      <span class="eco-arrow" aria-hidden="true">→</span>
    </a>
  </section>

  <section>
    <h2>Upstream contributions</h2>
    <p class="sub">I don't just consume these specs. I help build the tooling and the specs themselves.</p>
    <dl class="rows">
      {
        CONTRIBUTIONS.map((c) => (
          <div class="row">
            <dt><a href={githubUrl(c.repo)}>{c.repo}</a></dt>
            <dd>{c.summary}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section>
    <h2>Elsewhere</h2>
    <p class="sub">
      Conference speaker (Umbraco Poland Festival and others) and <a href="https://archiveprogram.github.com/arctic-vault/">Arctic Code Vault</a> contributor. Earlier work covered search, indexing and the Umbraco ecosystem; those packages remain on NuGet
      and are listed under <a href={`${ECOSYSTEM_URL}/#examine`}>Legacy</a>, but are no longer actively developed.
    </p>
  </section>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  .hero { padding: 88px 0 56px; }
  .hero-top { display: flex; align-items: center; gap: 40px; }
  .intro { flex: 1; min-width: 0; }
  .avatar {
    flex: none;
    display: grid; place-items: center;
    width: 180px; height: 180px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--accent-soft), var(--shadow);
  }
  .initials { background: var(--accent-soft); color: var(--accent); font-size: 3.4rem; font-weight: 660; letter-spacing: -.02em; }
  .lede strong { color: var(--fg); font-weight: 600; }
  .cta { margin-top: 30px; }
  .cta a { padding: 9px 15px; font-size: 14.5px; }
  .cta a svg { width: 16px; height: 16px; fill: currentColor; flex: none; }
  .cta a.primary { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .cta a.primary:hover { color: var(--bg); filter: brightness(1.08); }
  .sub a { color: var(--accent); }

  .flagship {
    display: flex; flex-direction: column; gap: 20px;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(90% 70% at 0% 0%, hsl(255 85% 60% / .10), transparent 60%),
      var(--bg-elev);
    box-shadow: var(--shadow);
  }
  .flag-head { display: flex; align-items: center; gap: 18px; min-width: 0; }
  .flag-head > div { min-width: 0; }
  .flagship h3 { margin: 0 0 4px; font-size: 1.3rem; font-weight: 660; letter-spacing: -.014em; overflow-wrap: anywhere; }
  .flagship h3 a { color: var(--accent); text-decoration: none; }
  .flagship h3 a:hover { text-decoration: underline; }
  .meta { margin: 0; font-size: 12px; color: var(--fg-faint); }
  .flag-summary { margin: 0; color: var(--fg-muted); font-size: 15.5px; max-width: 66ch; }

  .install {
    display: flex; align-items: center; gap: 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    padding: 4px 4px 4px 14px;
    min-width: 0;
  }
  .install pre { margin: 0; flex: 1; min-width: 0; overflow-x: auto; padding: 8px 0; }
  .copy {
    flex: none;
    font: inherit; font-size: 13px; font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border: 0;
    border-radius: 7px;
    padding: 7px 12px;
    cursor: pointer;
  }

  .parts { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 14px; }

  .top { list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: var(--bg-elev); }
  .top li { display: grid; grid-template-columns: 2ch minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 11px 16px; font-size: 14px; }
  .top li + li { border-top: 1px solid var(--border); }
  .rank { color: var(--fg-faint); }
  .id { text-decoration: none; overflow-wrap: anywhere; }
  .id:hover { color: var(--accent); }
  .downloads { color: var(--fg-muted); font-size: 13px; }

  .ecosystem {
    display: flex; align-items: center; gap: 20px;
    padding: 26px 28px;
    border-radius: 18px;
    border: 1px solid transparent;
    background: var(--accent-soft);
    text-decoration: none;
    transition: border-color .15s, transform .15s;
  }
  .ecosystem:hover { border-color: var(--accent); transform: translateY(-2px); }
  .eco-text { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
  .eco-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase; color: var(--accent); }
  .eco-text strong { font-size: 1.32rem; font-weight: 660; letter-spacing: -.012em; }
  .eco-text span:last-child { color: var(--fg-muted); font-size: 15px; }
  .eco-arrow { font-size: 2rem; color: var(--accent); flex: none; }

  .rows { display: grid; gap: 1px; margin: 0; background: var(--border); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .row { display: grid; grid-template-columns: 210px 1fr; gap: 16px; background: var(--bg-elev); padding: 12px 16px; font-size: 14px; }
  .row dt { font-weight: 600; margin: 0; overflow-wrap: anywhere; }
  .row dt a { color: var(--accent); text-decoration: none; }
  .row dt a:hover { text-decoration: underline; }
  .row dd { margin: 0; color: var(--fg-muted); }

  @media (max-width: 620px) {
    .hero { padding: 56px 0 40px; }
    .hero-top { flex-direction: column-reverse; align-items: flex-start; gap: 20px; }
    .avatar { width: 96px; height: 96px; }
    .initials { font-size: 2rem; }
    .flagship { padding: 18px; }
    .row { grid-template-columns: 1fr; gap: 6px; }
    .ecosystem { padding: 20px; }
  }
</style>
